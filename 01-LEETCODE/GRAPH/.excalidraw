    {
      "id": "MlFG4gyxbGvRB2G73J91J",
      "type": "text",
      "x": 745.4437407703304,
      "y": 1918.8000183105469,
      "width": 307.51254287340174,
      "height": 305.59997558593756,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1425925872,
      "version": 729,
      "versionNonce": 313170448,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795606556017,
      "link": null,
      "locked": false,
      "text": "bool dfs(int curr , int end){\n    if(curr==end){\n        return true;\n    }\n    visited.insert(curr);\n\n    for(auto neighbour: graph[curr]){\n        if(! visited.count(neighbour)){\n            bool result = dfs(neighbour , end);\n            if(result){\n                return true;\n            }\n        }\n    }\n    return false;\n\n}",
      "fontSize": 14.381175321691183,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool dfs(int curr , int end){\n    if(curr==end){\n        return true;\n    }\n    visited.insert(curr);\n\n    for(auto neighbour: graph[curr]){\n        if(! visited.count(neighbour)){\n            bool result = dfs(neighbour , end);\n            if(result){\n                return true;\n            }\n        }\n    }\n    return false;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
