      ],
      "updated": 1795405199710,
      "link": null,
      "locked": false,
      "text": "int raise(int a, int b)\n{\n    if (b == 1)\n    {\n        return a;\n    }\n    if (b % 2 == 0)\n    {\n        return raise(a, b / 2) * raise(a, b / 2);\n    }\n    else\n    {\n        return raise(a, b / 2) * raise(a, b / 2) * a;\n    }\n}",
      "fontSize": 8.837273964647405,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int raise(int a, int b)\n{\n    if (b == 1)\n    {\n        return a;\n    }\n    if (b % 2 == 0)\n    {\n        return raise(a, b / 2) * raise(a, b / 2);\n    }\n    else\n    {\n        return raise(a, b / 2) * raise(a, b / 2) * a;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
